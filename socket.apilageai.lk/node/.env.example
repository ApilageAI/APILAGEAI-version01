# ================================================================
# ApilageAI Node.js Socket & AI Server Environment Configuration
# ================================================================

PORT=5001
NODE_ENV=production

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=apilageai_main_db
DB_USER=db_user
DB_PASSWORD=your_db_password
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# AI Configuration (Gemini)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_IMAGE_MODEL=

# Domain & Security
APP_URL=https://apilageai.lk
PUBLIC_BASE_URL=https://apilageai.lk
ALLOWED_ORIGINS=https://apilageai.lk
TRUST_PROXY=false
BLOCK_DANGEROUS_INPUTS=true

# Local Directories (optional overrides)
# APILAGEAI_ROOT=/path/to/apilageai.lk
# UPLOADS_DIR=/path/to/uploads
# DOC_TEXT_DIR=/path/to/doc_text
SHARE_LINK_TTL_DAYS=7
