# ================================================================
# ApilageAI Environment Configuration Template
# 
# INSTRUCTIONS:
# 1. Copy this file to .env or .env.local
# 2. Update all values for your environment
# 3. NEVER commit .env or credentials to version control
# ================================================================

# Environment & Application
APP_NAME=ApilageAI
APP_ENV=production
APP_DEBUG=false
APP_URL=https://apilageai.lk
APP_TIMEZONE=Asia/Colombo
NODE_API_BASE=https://socket.apilageai.lk
UPLOADS_BASE_URL=https://socket.apilageai.lk
ALLOWED_ORIGINS=https://apilageai.lk
COOKIE_DOMAIN=.apilageai.lk
COOKIE_SAMESITE=Strict

# Database Configuration (Used by PHP Backend & Node Socket Server)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=apilageai_main_db
DB_USER=db_user
DB_PASS=db_password_here
DB_PASSWORD=db_password_here
DB_CHARSET=utf8mb4
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# Node Socket Server
PORT=5001
TRUST_PROXY=false
BLOCK_DANGEROUS_INPUTS=true
SHARE_LINK_TTL_DAYS=7

# SMTP Email Configuration
SMTP_HOST=mail.apilageai.lk
SMTP_PORT=587
SMTP_USER=no-reply@apilageai.lk
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=no-reply@apilageai.lk
SMTP_FROM_NAME=ApilageAI
SMTP_ENCRYPTION=tls

# AI APIs
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY_QUIZ=your_gemini_api_key
GEMINI_API_KEY_SIDEQA=your_gemini_api_key
GEMINI_API_KEY_MCQBLUST=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
YOUTUBE_API_KEY=your_youtube_api_key

# OAuth & Authentication
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://apilageai.lk/auth/google-callback

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://apilageai.lk/auth/facebook-callback

GLOBBOOK_APP_ID=your_globbook_app_id
GLOBBOOK_APP_SECRET=your_globbook_app_secret

# Captcha / Bot Protection
RECAPTCHA_SITE_KEY=your_turnstile_or_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_turnstile_or_recaptcha_secret_key

# Third-party Integrations
WHITEBOARD_TEAM_CLIENT_ID=your_whiteboard_client_id
WHITEBOARD_TEAM_CLIENT_SECRET=your_whiteboard_client_secret

# Payment Gateways
PAYABLE_SANDBOX=false
PAYABLE_MERCHANT_KEY=your_payable_merchant_key
PAYABLE_MERCHANT_TOKEN=your_payable_merchant_token

PAYPAL_SANDBOX=false
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_LKR_TO_USD_RATE=0.0032

# Security & Encryption
APP_KEY=generate_with_bin2hex_random_bytes_32
SESSION_LIFETIME=31536000
